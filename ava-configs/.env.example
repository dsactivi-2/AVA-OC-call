# =========================================================================
# .env.example — AVA AI Voice Agent Environment Variables
# Kopieren nach .env und Werte befuellen
# NIEMALS .env in Git committen!
# =========================================================================

# -------------------------------------------------------------------------
# OpenClaw LLM Backend
# -------------------------------------------------------------------------
# URL zum OpenClaw API (OpenAI-kompatibel)
OPENCLAW_API_URL=http://127.0.0.1:18789

# API-Key (leer lassen wenn OpenClaw keine Auth erfordert)
OPENCLAW_API_KEY=

# -------------------------------------------------------------------------
# Asterisk ARI (Asterisk REST Interface)
# -------------------------------------------------------------------------
ASTERISK_ARI_URL=http://127.0.0.1:8088
ASTERISK_ARI_USER=ava-bot
ASTERISK_ARI_PASSWORD=<DEIN_ARI_PASSWORT>

# -------------------------------------------------------------------------
# Asterisk AMI (Asterisk Manager Interface)
# Fuer Kampagnen-Scripts (Originate)
# -------------------------------------------------------------------------
ASTERISK_AMI_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=ava-campaign
ASTERISK_AMI_PASSWORD=<DEIN_AMI_PASSWORT>

# -------------------------------------------------------------------------
# Speech-to-Text
# -------------------------------------------------------------------------
# Deepgram API Key (nur noetig wenn stt.provider = deepgram)
DEEPGRAM_API_KEY=

# -------------------------------------------------------------------------
# Text-to-Speech: ElevenLabs
# -------------------------------------------------------------------------
ELEVENLABS_API_KEY=

# -------------------------------------------------------------------------
# Text-to-Speech: Azure Cognitive Services (Alternative)
# -------------------------------------------------------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# -------------------------------------------------------------------------
# Kampagnen-Einstellungen
# -------------------------------------------------------------------------
# Standard-Pause zwischen Calls in einer Kampagne (Sekunden)
CAMPAIGN_CALL_INTERVAL=30

# Maximale parallele Calls
CAMPAIGN_MAX_CONCURRENT=5

# Retry-Pause bei AMD=NOTSURE oder keine Antwort (Stunden)
CAMPAIGN_RETRY_HOURS=2

# Maximale Retry-Versuche pro Lead
CAMPAIGN_MAX_RETRIES=3

# -------------------------------------------------------------------------
# Logging
# -------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=/var/log/ava/agent.log
