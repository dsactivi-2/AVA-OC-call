# ============================================================
# AVA + Asterisk + OpenClaw — 2-Server Setup
# Kopiere diese Datei nach .env.local und fülle alle Werte aus
# Dann: source .env.local && sudo ./install-pbx.sh (auf PBX)
#        source .env.local && sudo ./install-ai.sh  (auf AI)
# ============================================================

# ===== SERVER IPs =====
PBX_HOST=94.130.180.62          # IP des PBX-Servers (Asterisk + FreePBX)
AI_HOST=49.13.144.44            # IP des AI-Servers (AVA + OpenClaw)

# ===== ASTERISK VERBINDUNG =====
AUDIOSOCKET_PORT=8090           # AudioSocket Port (muss auf beiden Servern gleich sein)
ARI_USERNAME=ava-bot            # ARI Benutzername
ARI_PASSWORD=                   # PFLICHT: min. 12 Zeichen
AMI_USERNAME=ava-campaign       # AMI Benutzername
AMI_PASSWORD=                   # PFLICHT: min. 12 Zeichen

# ===== SIPGATE (nur für install-pbx.sh) =====
SIPGATE_HOST=212.9.44.242       # Sipgate SIP IP (IPv4 — kein Hostname!)
SIP_AUTH_USER=                  # Sipgate SIP Username (z.B. 1234567e0)
SIP_AUTH_PASS=                  # Sipgate SIP Passwort
SIP_PHONE_NUMBER=               # Deine Sipgate Nummer (+4930...)

# ===== OPENCLAW (nur für install-ai.sh) =====
OPENCLAW_URL=http://127.0.0.1:18789/v1   # OpenClaw API URL
OPENCLAW_MODEL=ava              # OpenClaw Modell

# ===== API KEYS (nur für install-ai.sh) =====
ELEVENLABS_API_KEY=             # ElevenLabs TTS (empfohlen)
DEEPGRAM_API_KEY=               # Deepgram STT (empfohlen für BS/SR/DE)
AZURE_SPEECH_KEY=               # Azure Cognitive Services (optional)
AZURE_SPEECH_REGION=westeurope  # Azure Region (optional)
