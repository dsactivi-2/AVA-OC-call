# =============================================================================
# .env.example — AVA AI Voice Agent Konfiguration
# Kopieren nach .env und alle Werte befuellen
# NIEMALS .env in Git committen!
# =============================================================================

# OpenClaw LLM Backend (OpenAI-kompatibler Endpunkt)
OPENCLAW_API_URL=http://127.0.0.1:18789/v1
OPENCLAW_MODEL=ava
OPENCLAW_API_KEY=

# Asterisk ARI
ASTERISK_ARI_URL=http://127.0.0.1:8088
ASTERISK_ARI_USER=ava-bot
ASTERISK_ARI_PASS=

# Asterisk AMI (fuer Kampagnen-Scripts)
ASTERISK_AMI_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=ava-campaign
ASTERISK_AMI_PASS=

# Speech-to-Text (nur noetig wenn stt.provider=deepgram)
DEEPGRAM_API_KEY=

# Text-to-Speech: ElevenLabs
ELEVENLABS_API_KEY=

# Text-to-Speech: Azure (Alternative)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Kampagnen-Einstellungen
CAMPAIGN_CALL_INTERVAL=30
CAMPAIGN_MAX_CONCURRENT=5
CAMPAIGN_RETRY_HOURS=2
CAMPAIGN_MAX_RETRIES=3

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/ava/agent.log
